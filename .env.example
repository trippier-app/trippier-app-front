##################################### Maps #####################################
MAPTILER_API_KEY=your_maptiler_api_key
MAPTILER_MAP_ID=basic-v2

################################## Public API ##################################
POI_API_URL=http://host.docker.internal:8080

# Signs the X-Internal-Auth header so our own calls skip the API-key quota.
# Must match the public-API and landing stacks' secret.
INTERNAL_SECRET=change-me-internal-secret

# Fallback when no INTERNAL_SECRET is set: a regular metered consumer key.
POI_API_KEY=

########################### docker-compose (make) ##############################
FRONT_PORT=3010

REGISTRY=ghcr.io
OWNER=trippier-app
TAG=latest

################################## production ##################################
FRONT_DOMAIN=app.trippier.dev
EDGE_NETWORK=trippier-public-api_default
IMAGE_TAG=latest

# Base URL of the product back-end (accounts), server-side only.
BACK_API_URL=http://host.docker.internal:3011
